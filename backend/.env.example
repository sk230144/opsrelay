# Copy to .env and adjust.
# Postgres (docker compose up -d):
# DATABASE_URL=postgresql+psycopg://opsrelay:opsrelay@localhost:5432/opsrelay
# Leave unset to use the bundled SQLite file instead.

SECRET_KEY=dev-only-insecure-change-me
DEBUG=true

# Must be reachable from the device, not just the host, for photos to load.
# Android emulator: http://10.0.2.2:8000
# Physical device:  http://<your-LAN-IP>:8000
PUBLIC_BASE_URL=http://localhost:8000
